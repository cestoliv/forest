# Ignore .claude/* contents (settings.local.json etc.) but keep the shared docs.
# Must exclude the contents, not the directory: git does not descend into an
# excluded directory, so a `!` exception under `.claude/` would never apply.
.claude/*
!.claude/docs/
.superpowers/

# Swift Package Manager (apps/ide-toggler/macos)
.swiftpm/
Package.resolved

# Generated app bundle (produced by apps/ide-toggler/macos/scripts/make_app.sh)
IdeToggler.app/

# Xcode
*.xcodeproj
*.xcworkspace
DerivedData/

# Zed editor settings
.zed/
