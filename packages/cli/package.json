{
  "name": "@cestoliv/wt",
  "version": "0.5.2",
  "description": "Fast, interactive TUI to browse, create, open, and delete git worktrees across repos.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cestoliv/worktrees.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "wt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "fuse.js": "^7.1.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
